# Hausbuch v2 — environment variables
# Copy to `.env` (gitignored) and fill in the real values.

# ─── Database ────────────────────────────────────────────────────────────────
# Vercel Postgres injects DATABASE_URL automatically into deployments.
# For local dev, copy the connection string from your Vercel dashboard:
#   Project → Storage → <your-postgres> → .env.local tab → DATABASE_URL
# Format: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://user:pass@localhost:5432/hausbuch?schema=public"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"

# Public base URL for auth redirects. In dev: http://localhost:3000
# In prod: https://hausbuch.yashsuhagiya.com
BETTER_AUTH_URL="http://localhost:3000"

# ─── Google OAuth (optional, for one-tap Google sign-in) ─────────────────────
# Register at https://console.cloud.google.com/apis/credentials
# - Authorized redirect URIs (add both):
#     http://localhost:3000/api/auth/callback/google
#     https://hausbuch.yashsuhagiya.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
